    "/healthz": {
      "get": {
        "operationId": "liveness",
        "summary": "Check the API process is running",
        "tags": [
          "Health"
        ],
        "description": "Liveness check: answers as long as the API process can serve requests. It checks no\ndependencies, so a database or storage outage does not make it fail (use `/readyz`\nfor that). Behind the app's nginx, `/healthz` is answered by nginx itself.",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "The process is up."
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "summary": "Check the API can reach its database and storage",
        "tags": [
          "Health"
        ],
        "description": "Readiness check: pings Postgres (`db`) and the inbox bucket in object storage\n(`storage`). Answers `200` with `status: ok` when both respond, otherwise `503`\nwith `status: degraded` and the failed check's error message.",
        "security": [],
        "responses": {
          "200": {
            "description": "Postgres and storage are reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Each dependency's result: `ok`, or the error message of the failed check."
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "additionalProperties": false,
                  "description": "Postgres and storage are reachable."
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency failed its check.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Each dependency's result: `ok`, or the error message of the failed check."
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "additionalProperties": false,
                  "description": "At least one dependency failed its check."
                }
              }
            }
          }
        }
      }
    }
  },
