{
  "description": "Plugin steps in a recipe (docs/design/recipe-plugins.md). Read by packages/shared/test/template.test.ts (TemplateSchema) and worker/tests/test_template.py (Template): every case's pipeline replaces the base's; `error` is a substring both sides' messages contain.",
  "base": {
    "id": "letter",
    "version": 1,
    "name": "Letter",
    "document": {
      "sections": [
        { "id": "head", "anchor": "\\A" },
        { "id": "items", "anchor": "^ITEM", "repeat": true, "key": "^ITEM (\\S+)" }
      ]
    },
    "outputs": {
      "fields": [
        { "id": "sender", "type": "text" },
        { "id": "reference", "type": "text" }
      ],
      "tables": [
        {
          "id": "lines",
          "columns": [
            { "id": "sku", "type": "text" },
            { "id": "qty", "type": "integer" }
          ]
        }
      ]
    },
    "pipeline": []
  },
  "cases": [
    {
      "name": "a plugin step fills fields from a section",
      "valid": true,
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["sender", "reference"],
          "sections": ["head"],
          "with": { "patterns": { "reference": "Ref:\\s*(?P<value>\\S+)" } }
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin step fills a table from earlier values only",
      "valid": true,
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "acme.lines_from_ref@2",
          "table": "lines",
          "context": { "ref": "reference" }
        }
      ]
    },
    {
      "name": "an extract step reads a plugin step's output",
      "valid": true,
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["reference"],
          "sections": ["head"]
        },
        {
          "type": "extract",
          "id": "who",
          "fields": ["sender"],
          "sections": ["head"],
          "context": { "ref": "reference" }
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a check reads a plugin-filled column",
      "valid": true,
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "text.pattern@1",
          "table": "lines",
          "sections": ["head"]
        },
        { "type": "check", "id": "sku_check", "values": "lines.sku", "reference": "lines.sku" }
      ]
    },
    {
      "name": "a plugin step must fill something",
      "valid": false,
      "error": "a step must fill either fields or a table",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] },
        { "type": "plugin", "id": "idle", "uses": "text.pattern@1", "sections": ["head"] }
      ]
    },
    {
      "name": "an output is filled by an extract step and a plugin step",
      "valid": false,
      "error": "is filled by more than one step",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin step names an unknown section",
      "valid": false,
      "error": "unknown section",
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["sender", "reference"],
          "sections": ["nope"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin step names an unknown field",
      "valid": false,
      "error": "unknown field",
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["sender", "reference", "nope"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin table step reads a repeating section",
      "valid": true,
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "text.pattern@1",
          "table": "lines",
          "sections": ["items"]
        }
      ]
    },
    {
      "name": "a plugin step fills a key column with each occurrence's key",
      "valid": true,
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "text.pattern@1",
          "table": "lines",
          "sections": ["items"],
          "keyColumn": "sku"
        }
      ]
    },
    {
      "name": "a plugin field step cannot read a repeating section",
      "valid": false,
      "error": "a field step cannot read a repeating section",
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["sender", "reference"],
          "sections": ["items"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin step's keyColumn needs a repeating section",
      "valid": false,
      "error": "keyColumn needs a repeating section with a key or keyFrom",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "text.pattern@1",
          "table": "lines",
          "sections": ["head"],
          "keyColumn": "sku"
        }
      ]
    },
    {
      "name": "a plugin step's keyColumn must be a column of its table",
      "valid": false,
      "error": "is not a column of lines",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "plugin",
          "id": "rows",
          "uses": "text.pattern@1",
          "table": "lines",
          "sections": ["items"],
          "keyColumn": "nope"
        }
      ]
    },
    {
      "name": "a plugin step's context names a later output",
      "valid": false,
      "error": "which is not filled by an earlier step",
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["reference"],
          "sections": ["head"],
          "context": { "who": "sender" }
        },
        { "type": "extract", "id": "who", "fields": ["sender"], "sections": ["head"] },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "an extract step's context names a later plugin output",
      "valid": false,
      "error": "which is not filled by an earlier step",
      "pipeline": [
        {
          "type": "extract",
          "id": "who",
          "fields": ["sender"],
          "sections": ["head"],
          "context": { "ref": "reference" }
        },
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "fields": ["reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "uses names a plugin id and a major version",
      "valid": false,
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "Text Pattern",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "uses needs a version",
      "valid": false,
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a plugin step may name a model choice (for a plugin that calls a model)",
      "valid": true,
      "pipeline": [
        {
          "type": "plugin",
          "id": "refs",
          "uses": "text.pattern@1",
          "model": "main",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        { "type": "extract", "id": "rows", "table": "lines", "sections": ["items"] }
      ]
    },
    {
      "name": "a check may name a plugin instead of a reference",
      "valid": true,
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "extract",
          "id": "rows",
          "table": "lines",
          "sections": ["items"]
        },
        {
          "type": "check",
          "id": "names",
          "uses": "list.lookup@1",
          "values": "lines.sku",
          "with": { "values": ["A1"] }
        }
      ]
    },
    {
      "name": "a check runs a plugin or compares with a reference, not both",
      "valid": false,
      "error": "a check runs a plugin or compares with a reference, not both",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "extract",
          "id": "rows",
          "table": "lines",
          "sections": ["items"]
        },
        {
          "type": "check",
          "id": "names",
          "uses": "list.lookup@1",
          "values": "lines.sku",
          "reference": "lines.sku"
        }
      ]
    },
    {
      "name": "a check needs a reference or a plugin",
      "valid": false,
      "error": "a check needs a reference or a plugin",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "extract",
          "id": "rows",
          "table": "lines",
          "sections": ["items"]
        },
        { "type": "check", "id": "names", "values": "lines.sku" }
      ]
    },
    {
      "name": "a plugin check still resolves its values",
      "valid": false,
      "error": "unknown field or column",
      "pipeline": [
        {
          "type": "extract",
          "id": "head",
          "fields": ["sender", "reference"],
          "sections": ["head"]
        },
        {
          "type": "extract",
          "id": "rows",
          "table": "lines",
          "sections": ["items"]
        },
        { "type": "check", "id": "names", "uses": "list.lookup@1", "values": "lines.nope" }
      ]
    }
  ]
}
