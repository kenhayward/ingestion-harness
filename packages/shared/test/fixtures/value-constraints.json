{
  "description": "Constraints on fields and columns (docs/design/output-roles.md §1): range, pattern and length. Read by packages/shared/test/template.test.ts (TemplateSchema) and worker/tests/test_template.py (Template): every case's fields replace the base's outputs.fields; `error` is a substring both sides' messages contain. Patterns are Python `re` syntax, which both sides must accept or refuse alike.",
  "base": {
    "id": "assay",
    "version": 1,
    "name": "Assay certificate",
    "document": { "sections": [{ "id": "head", "anchor": "\\A" }] },
    "outputs": { "fields": [] },
    "pipeline": [
      { "type": "extract", "id": "head", "fields": ["assay", "batch"], "sections": ["head"] }
    ]
  },
  "cases": [
    {
      "name": "a range on a decimal",
      "valid": true,
      "fields": [
        { "id": "assay", "type": "decimal", "range": { "min": 90, "max": 110 } },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a lower bound only, on an integer",
      "valid": true,
      "fields": [
        { "id": "assay", "type": "integer", "range": { "min": 0 } },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a pattern and a length on a text",
      "valid": true,
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "pattern": "^[A-Z]{2}\\d{4}$", "length": { "max": 12 } }
      ]
    },
    {
      "name": "a pattern with a named group (Python syntax)",
      "valid": true,
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "pattern": "(?P<prefix>[A-Z]+)\\d+" }
      ]
    },
    {
      "name": "a pattern with a leading inline flag",
      "valid": true,
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "pattern": "(?i)^[a-z]{2}\\d{4}$" }
      ]
    },
    {
      "name": "a range on a text",
      "valid": false,
      "error": "range needs a decimal or integer",
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "range": { "min": 1 } }
      ]
    },
    {
      "name": "a range whose min is above its max",
      "valid": false,
      "error": "min is above max",
      "fields": [
        { "id": "assay", "type": "decimal", "range": { "min": 5, "max": 1 } },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a range with no bound",
      "valid": false,
      "error": "range needs min or max",
      "fields": [
        { "id": "assay", "type": "decimal", "range": {} },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a pattern on a decimal",
      "valid": false,
      "error": "pattern needs a text",
      "fields": [
        { "id": "assay", "type": "decimal", "pattern": "^\\d+$" },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a pattern that is not a regular expression",
      "valid": false,
      "error": "is not a valid pattern",
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "pattern": "(" }
      ]
    },
    {
      "name": "a length on an integer",
      "valid": false,
      "error": "length needs a text",
      "fields": [
        { "id": "assay", "type": "integer", "length": { "max": 3 } },
        { "id": "batch", "type": "text" }
      ]
    },
    {
      "name": "a negative length",
      "valid": false,
      "error": "length cannot be negative",
      "fields": [
        { "id": "assay", "type": "decimal" },
        { "id": "batch", "type": "text", "length": { "min": -1 } }
      ]
    }
  ]
}
