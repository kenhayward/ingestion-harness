{
  "prefixes": [
    {
      "input": "",
      "expected": ""
    },
    {
      "input": "ingest",
      "expected": "ingest/"
    },
    {
      "input": "/ingest/",
      "expected": "ingest/"
    },
    {
      "input": " a/b ",
      "expected": "a/b/"
    }
  ],
  "delivery": [
    {
      "name": "no delivery",
      "definition": {},
      "formats": ["csv", "json"],
      "publishTargets": ["default"]
    },
    {
      "name": "target only",
      "definition": {
        "delivery": {
          "publishTo": "finance-lake"
        }
      },
      "formats": ["csv", "json"],
      "publishTargets": ["finance-lake"]
    },
    {
      "name": "formats only",
      "definition": {
        "delivery": {
          "formats": ["json"]
        }
      },
      "formats": ["json"],
      "publishTargets": ["default"]
    },
    {
      "name": "both",
      "definition": {
        "delivery": {
          "formats": ["csv"],
          "publishTo": "lake_2"
        }
      },
      "formats": ["csv"],
      "publishTargets": ["lake_2"]
    },
    {
      "name": "a one-item list",
      "definition": {
        "delivery": {
          "publishTo": ["finance-lake"]
        }
      },
      "formats": ["csv", "json"],
      "publishTargets": ["finance-lake"]
    },
    {
      "name": "a list, in order",
      "definition": {
        "delivery": {
          "formats": ["json"],
          "publishTo": ["archive", "default", "lake_2"]
        }
      },
      "formats": ["json"],
      "publishTargets": ["archive", "default", "lake_2"]
    },
    {
      "name": "per-target name patterns",
      "definition": {
        "delivery": {
          "publishTo": ["default", "fake-target"],
          "settings": {
            "fake-target": {
              "name": "{field:sender|source.stem}"
            }
          }
        }
      },
      "formats": ["csv", "json"],
      "publishTargets": ["default", "fake-target"],
      "settings": {
        "fake-target": {
          "name": "{field:sender|source.stem}"
        }
      }
    }
  ],
  "seed": [
    {
      "name": "all blank: internal",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s"
      },
      "expected": {
        "kind": "internal",
        "bucket": "ingest-published",
        "prefix": "",
        "endpoint": null,
        "region": null,
        "accessKeyEnv": null,
        "secretKeyEnv": null,
        "forcePathStyle": true
      }
    },
    {
      "name": "same endpoint, same keys: internal",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_ENDPOINT": "http://seaweed:8333",
        "TARGET_S3_ACCESS_KEY": "k",
        "TARGET_S3_SECRET_KEY": "s",
        "TARGET_S3_BUCKET": "pub"
      },
      "expected": {
        "kind": "internal",
        "bucket": "pub",
        "prefix": "",
        "endpoint": null,
        "region": null,
        "accessKeyEnv": null,
        "secretKeyEnv": null,
        "forcePathStyle": true
      }
    },
    {
      "name": "same endpoint, other keys: external",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_ENDPOINT": "http://seaweed:8333",
        "TARGET_S3_ACCESS_KEY": "other",
        "TARGET_S3_SECRET_KEY": "other-secret"
      },
      "expected": {
        "kind": "external",
        "bucket": "ingest-published",
        "prefix": "",
        "endpoint": "http://seaweed:8333",
        "region": "us-east-1",
        "accessKeyEnv": "TARGET_S3_ACCESS_KEY",
        "secretKeyEnv": "TARGET_S3_SECRET_KEY",
        "forcePathStyle": true
      }
    },
    {
      "name": "other endpoint: external",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_ENDPOINT": "https://s3.eu-west-2.amazonaws.com",
        "TARGET_S3_REGION": "eu-west-2",
        "TARGET_S3_ACCESS_KEY": "aws-k",
        "TARGET_S3_SECRET_KEY": "aws-s",
        "TARGET_S3_BUCKET": "lake"
      },
      "expected": {
        "kind": "external",
        "bucket": "lake",
        "prefix": "",
        "endpoint": "https://s3.eu-west-2.amazonaws.com",
        "region": "eu-west-2",
        "accessKeyEnv": "TARGET_S3_ACCESS_KEY",
        "secretKeyEnv": "TARGET_S3_SECRET_KEY",
        "forcePathStyle": true
      }
    },
    {
      "name": "endpoint blank, other keys: external, endpoint from S3_ENDPOINT",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_ACCESS_KEY": "other",
        "TARGET_S3_SECRET_KEY": "other-secret"
      },
      "expected": {
        "kind": "external",
        "bucket": "ingest-published",
        "prefix": "",
        "endpoint": "http://seaweed:8333",
        "region": "us-east-1",
        "accessKeyEnv": "TARGET_S3_ACCESS_KEY",
        "secretKeyEnv": "TARGET_S3_SECRET_KEY",
        "forcePathStyle": true
      }
    },
    {
      "name": "other endpoint, keys blank: external, keys fall back to S3_*",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_ENDPOINT": "https://s3.eu-west-2.amazonaws.com",
        "TARGET_S3_REGION": "eu-west-2",
        "TARGET_S3_BUCKET": "lake"
      },
      "expected": {
        "kind": "external",
        "bucket": "lake",
        "prefix": "",
        "endpoint": "https://s3.eu-west-2.amazonaws.com",
        "region": "eu-west-2",
        "accessKeyEnv": "S3_ACCESS_KEY",
        "secretKeyEnv": "S3_SECRET_KEY",
        "forcePathStyle": true
      }
    },
    {
      "name": "prefix kept as .env had it (no slash added)",
      "env": {
        "S3_ENDPOINT": "http://seaweed:8333",
        "S3_ACCESS_KEY": "k",
        "S3_SECRET_KEY": "s",
        "TARGET_S3_PREFIX": "ingest"
      },
      "expected": {
        "kind": "internal",
        "bucket": "ingest-published",
        "prefix": "ingest",
        "endpoint": null,
        "region": null,
        "accessKeyEnv": null,
        "secretKeyEnv": null,
        "forcePathStyle": true
      }
    }
  ],
  "rdfSeed": [
    {
      "name": "no RDF_ENDPOINT: no triple store",
      "env": {},
      "expected": null
    },
    {
      "name": "a blank RDF_ENDPOINT: no triple store",
      "env": {
        "RDF_ENDPOINT": ""
      },
      "expected": null
    },
    {
      "name": "endpoint only: dataset ct, user ct-writer",
      "env": {
        "RDF_ENDPOINT": "http://fuseki:3030"
      },
      "expected": {
        "endpoint": "http://fuseki:3030",
        "dataset": "ct",
        "user": "ct-writer"
      }
    },
    {
      "name": "every setting",
      "env": {
        "RDF_ENDPOINT": "http://kb.internal:3030/",
        "RDF_DATASET": "kb",
        "RDF_USER": "writer"
      },
      "expected": {
        "endpoint": "http://kb.internal:3030/",
        "dataset": "kb",
        "user": "writer"
      }
    }
  ]
}
