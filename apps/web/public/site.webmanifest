{
  "id": "/",
  "name": "Content Transformation Studio",
  "short_name": "CT Studio",
  "description": "Turn known PDFs and Word documents into validated, structured data.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "theme_color": "#0A5BB0",
  "background_color": "#F3F5F8",
  "icons": [
    { "src": "/icon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "/icon-64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Upload documents",
      "short_name": "Upload",
      "url": "/#/upload",
      "icons": [{ "src": "/shortcut-upload.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "url": "/#/jobs",
      "icons": [{ "src": "/shortcut-jobs.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Workbench",
      "url": "/#/workbench",
      "icons": [{ "src": "/shortcut-workbench.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home: upload documents and follow the latest job as it runs"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Jobs on a narrow window"
    }
  ]
}
