# Copy to deploy/.env for local use. On deploy hosts keep the real file outside the repo
# (default: /etc/ingestion-harness/<environment>.env) and point ENV_FILE at it.

COMPOSE_PROJECT_NAME=ingestion
IMAGE_PREFIX=ingestion-harness
# IMAGE_TAG defaults to the current git short SHA in deploy.sh

# --- app (nginx) ---
APP_BIND=0.0.0.0
APP_PORT=8081

# --- postgres ---
POSTGRES_USER=ingest
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ingest
# Host port for Postgres (dev overlay only)
POSTGRES_PORT=5433

# --- SeaweedFS S3 ---
S3_ACCESS_KEY=ingest-admin
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET_INBOX=ingest-inbox
S3_BUCKET_OUTPUTS=ingest-outputs
S3_BUCKET_RUNS=ingest-runs

# --- final target for approved outputs (any S3 endpoint) ---
# Leave endpoint/keys empty to publish into the same SeaweedFS (bucket created automatically).
TARGET_S3_ENDPOINT=
TARGET_S3_REGION=
TARGET_S3_ACCESS_KEY=
TARGET_S3_SECRET_KEY=
TARGET_S3_BUCKET=ingest-published
TARGET_S3_PREFIX=
# The data lake's URL for the publish bucket (your proxy in front of the S3 port; ADR 0008).
# Shown with each new read-only S3 key on the Access page. Optional.
S3_PUBLIC_URL=
# Expose the S3 endpoint beyond localhost for downstream loaders (e.g. 0.0.0.0)
S3_PUBLIC_BIND=127.0.0.1
S3_PUBLIC_PORT=8335
# SeaweedFS master UI (no authentication). Set 0.0.0.0 to reach it from other machines.
SEAWEEDFS_MASTER_BIND=127.0.0.1
SEAWEEDFS_MASTER_PORT=9334

# --- api ---
LOG_LEVEL=info
MAX_UPLOAD_MB=50
# Extra proxies whose X-Forwarded-* headers the API trusts (client IP for sign-in limits, HTTPS
# for Secure cookies), *added* to the private networks. Set when your TLS proxy reaches the host
# from a public address.
TRUST_PROXY=

# --- worker / LLM providers (see config/llm-providers.yaml) ---
WORKER_REPLICAS=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default extraction model (alias `default`) lives on this endpoint, and so does the OCR model
# unless OCR_BASE_URL points OCR at another server (same provider and options; OCR_API_KEY,
# when set, replaces LOCAL_LLM_API_KEY for OCR calls).
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://192.168.1.129:1234/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_RESPONSE_FORMAT=json_schema
OCR_ENABLED=true
OCR_MODEL=local/olmocr-2-7b-1025
# The OCR endpoint inherits the named provider's `location` for the data policy (ADR 0007): only point a local-marked provider at hosts you treat as local.
OCR_BASE_URL=
OCR_API_KEY=
# Workbench drafting model (alias `draft`). Projects are local-only by default: an external model
# (e.g. anthropic/claude-opus-5-5) is refused until an admin allows it for that project.
DRAFT_MODEL=local/qwen3.8-27b-mtp
POLL_INTERVAL_S=2
DISCOVERY_INTERVAL_S=3600
