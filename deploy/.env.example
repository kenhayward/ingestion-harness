# Copy to deploy/.env for local use. On deploy hosts keep the real file outside the repo
# (default: /etc/ingestion-harness/<environment>.env) and point ENV_FILE at it.

COMPOSE_PROJECT_NAME=ingestion
IMAGE_PREFIX=ingestion-harness
# IMAGE_TAG defaults to the current git short SHA in deploy.sh

# --- app (nginx) ---
APP_BIND=0.0.0.0
APP_PORT=8080

# --- postgres ---
POSTGRES_USER=ingest
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ingest

# --- SeaweedFS S3 ---
SEAWEEDFS_TAG=latest
S3_ACCESS_KEY=ingest-admin
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET_INBOX=ingest-inbox
S3_BUCKET_OUTPUTS=ingest-outputs
S3_BUCKET_RUNS=ingest-runs
# Expose the S3 endpoint beyond localhost for downstream loaders (e.g. 0.0.0.0)
S3_PUBLIC_BIND=127.0.0.1
S3_PUBLIC_PORT=8333

# --- api ---
LOG_LEVEL=info
MAX_UPLOAD_MB=50

# --- worker / LLM providers (see config/llm-providers.yaml) ---
WORKER_REPLICAS=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_RESPONSE_FORMAT=json_schema
POLL_INTERVAL_S=2
DISCOVERY_INTERVAL_S=3600
