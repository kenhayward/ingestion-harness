# Copy to deploy/.env for local use. On deploy hosts keep the real file outside the repo
# (default: /etc/ingestion-harness/<environment>.env) and point ENV_FILE at it.

COMPOSE_PROJECT_NAME=ingestion
IMAGE_PREFIX=ingestion-harness
# IMAGE_TAG defaults to the current git short SHA in deploy.sh

# --- app (nginx) ---
APP_BIND=0.0.0.0
APP_PORT=8081

# --- postgres ---
POSTGRES_USER=ingest
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ingest
# Host port for Postgres (dev overlay only)
POSTGRES_PORT=5433

# --- SeaweedFS S3 ---
S3_ACCESS_KEY=ingest-admin
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET_INBOX=ingest-inbox
S3_BUCKET_OUTPUTS=ingest-outputs
S3_BUCKET_RUNS=ingest-runs

# --- final target for approved outputs (any S3 endpoint) ---
# Leave endpoint/keys empty to publish into the same SeaweedFS (bucket created automatically).
TARGET_S3_ENDPOINT=
TARGET_S3_REGION=
TARGET_S3_ACCESS_KEY=
TARGET_S3_SECRET_KEY=
TARGET_S3_BUCKET=ingest-published
TARGET_S3_PREFIX=
# The data lake's URL for the publish bucket (your proxy in front of the S3 port; ADR 0008).
# Shown with each new read-only S3 key on the Access page. Optional.
S3_PUBLIC_URL=
# Expose the S3 endpoint beyond localhost for downstream loaders (e.g. 0.0.0.0)
S3_PUBLIC_BIND=127.0.0.1
S3_PUBLIC_PORT=8335
# SeaweedFS master UI (no authentication). Set 0.0.0.0 to reach it from other machines.
SEAWEEDFS_MASTER_BIND=127.0.0.1
SEAWEEDFS_MASTER_PORT=9334

# --- api ---
LOG_LEVEL=info
# Per-file upload limit (an ontology folder's files count together). The app's nginx allows
# 210 MB per request (keep it >= this; 200 fits ChEBI lite) and 650 MB for Workbench bundle
# imports, which take up to MAX_UPLOAD_MB x 12 samples + 8 MB (608 MB at 50); above 50 the
# bundle path's 650 MB is the effective cap. An outer reverse proxy (e.g. NGINX Proxy Manager)
# needs the same allowance; see deploy/README.md.
MAX_UPLOAD_MB=50
# Extra proxies whose X-Forwarded-* headers the API trusts (client IP for sign-in limits, HTTPS
# for Secure cookies), *added* to the private networks. Set when your TLS proxy reaches the host
# from a public address.
TRUST_PROXY=
# Sites that may show the app in a frame (ADR 0012): space-separated https origins, `*.` for any
# subdomain, e.g. https://*.3dexperience.3ds.com. Blank = nobody. Read by the app's nginx
# (frame-ancestors) and the API (over HTTPS the session cookie becomes SameSite=None; Secure;
# Partitioned so sign-in works inside the frame). An outer proxy must not add X-Frame-Options.
FRAME_ANCESTORS=

# --- worker / LLM providers (see config/llm-providers.yaml) ---
# These are DEFAULTS (ADR 0010): the worker seeds them into the database on start, and an
# admin's edits there win. Empty = the default in config/llm-providers.yaml.
# Worker containers: each runs one job at a time, and a job runs on one worker only (a running
# job beats a heartbeat, so another worker never takes it over); more workers, more jobs at once.
WORKER_REPLICAS=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Models offered in the pickers per provider (comma-separated).
ANTHROPIC_MODELS=
OPENAI_MODELS=
LOCAL_LLM_MODELS=
# Model choices: what people pick, by label, wherever a model is chosen (ADR 0010).
# `;`-separated: id=Label|endpoint/model-id[|default]; the first is the default unless one says
# `default` (template steps naming no model use it). Quote the value.
# LLM_CHOICES='main=Main Production Model|local/qwen3.8-27b-mtp|default;test=New for testing only|anthropic/claude-haiku-5-5'
LLM_CHOICES=
# Without LLM_CHOICES, for compatibility: DEFAULT_MODEL seeds the choice "Default model" (the
# default) and FAST_MODEL the choice "Fast model".
DEFAULT_MODEL=
FAST_MODEL=
# More endpoints, `;`-separated: name=baseUrl|model1,model2[|local|external[|kind]]
# (location defaults to local, kind to openai-chat). Keys, if needed: name=key;name2=key
# LLM_ENDPOINTS=gpu2=http://192.168.1.140:8000/v1|llama-4-70b,qwen3-32b
# LLM_ENDPOINT_KEYS=gpu2=sk-...
LLM_ENDPOINTS=
LLM_ENDPOINT_KEYS=
# Encrypts the keys admins enter on the Models page (AES-256-GCM; the api and the worker both
# need it). Empty: keys can only come from this file. Generate: openssl rand -base64 32
# To rotate, move the old value to LLM_SECRETS_KEY_PREVIOUS, set a new one, re-enter the keys.
LLM_SECRETS_KEY=
LLM_SECRETS_KEY_PREVIOUS=
# Users link GitHub accounts from Profile (docs/design/profile.md) through a GitHub OAuth app:
# GitHub > Settings > Developer settings > OAuth Apps, callback URL
# https://<this app>/api/profile/github/callback. Both or neither; tokens are kept under
# LLM_SECRETS_KEY (needed too). GITHUB_REDIRECT_URL: that callback, when the proxy's headers
# would give another address.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
# Default extraction model (alias `default`) lives on this endpoint, and so does the OCR model
# unless OCR_BASE_URL points OCR at another server (same provider and options; OCR_API_KEY,
# when set, replaces LOCAL_LLM_API_KEY for OCR calls).
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://192.168.1.129:1234/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_RESPONSE_FORMAT=json_schema
OCR_ENABLED=true
OCR_MODEL=local/olmocr-2-7b-1025
# The OCR endpoint inherits the named provider's `location` for the data policy (ADR 0007): only point a local-marked provider at hosts you treat as local.
OCR_BASE_URL=
OCR_API_KEY=
# Workbench drafting model (a pipeline setting, not a model choice). Projects are local-only by default: an external model
# (e.g. anthropic/claude-opus-5-5) is refused until an admin allows it for that project.
DRAFT_MODEL=local/qwen3.8-27b-mtp
# Embeds ontology terms for the Workbench mapping stage (ADR 0011): an `endpoint/model-id` on
# an OpenAI-compatible endpoint, e.g. local/nomic-embed-text-v1.5. Unset: lexical retrieval.
# EMBEDDING_MODEL=
POLL_INTERVAL_S=2
DISCOVERY_INTERVAL_S=3600
# Word (.docx) to PDF (the `converter` service, ADR 0009). Unset = the compose service; set it
# empty to disable Word documents. CONVERTER_PORT is the dev-infra port on localhost.
# CONVERTER_URL=http://converter:3000
# CONVERTER_PORT=3010
# Ontology imports over this many triples are refused (ADR 0011). A large vocabulary such as
# ChEBI lite (about 175 MB) needs more, e.g. 5000000, with ONTOLOGY_MAX_BYTES=209715200 to fetch
# it by URL or MAX_UPLOAD_MB=200 to upload it. Vocabularies are only read through the term
# index; keep ontologies pinned as SHACL shapes small (they are loaded whole per job).
# ONTOLOGY_MAX_TRIPLES=2000000
# Hosts ontologies may be imported from by URL, comma-separated: an exact host, or
# .example.org for a domain and its subdomains. Empty: URL imports are off.
# ONTOLOGY_FETCH_ALLOW=w3id.org,.pistoiaalliance.org
# Fetched ontology files over this many bytes are refused.
# ONTOLOGY_MAX_BYTES=104857600
# The deployment's customer for RDF (ADR 0011), `slug=Name`, and optionally their own base IRI.
# Read once to seed the Linked data page, which wins afterwards. Without a customer, RDF is not
# published (IRIs default to https://id.stocks-hayward.com/<slug>/).
# LINKED_DATA_CUSTOMER=acme=Acme Pharma Ltd
# LINKED_DATA_BASE_IRI=https://data.acme.example/
# The triple store (ADR 0011 step 6): the `rdf` profile starts Fuseki; the worker publishes each
# delivered graph to RDF_ENDPOINT as ct-writer. Remove these four to publish graphs to S3 only.
# ct-reader is the read-only user consumers query with.
COMPOSE_PROFILES=rdf
RDF_ENDPOINT=http://fuseki:3030
RDF_WRITER_PASSWORD=change-me-rdf-writer
RDF_READER_PASSWORD=change-me-rdf-reader
# FUSEKI_JAVA_OPTIONS=-Xmx2g
# Consumers (the shared read-only user ct-reader) query through the reverse proxy, which reaches
# Fuseki on FUSEKI_BIND:FUSEKI_PUBLIC_PORT; RDF_PUBLIC_URL is the proxy's URL, shown on the
# Linked data page (deploy/README.md, docs/consumers/sparql.md).
FUSEKI_BIND=127.0.0.1
FUSEKI_PUBLIC_PORT=3030
# RDF_PUBLIC_URL=https://sparql.acme.example/
